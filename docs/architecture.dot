// ws-trade-bot architecture - render with:
//   dot -Tpng -o docs/architecture.png docs/architecture.dot
digraph architecture {
  rankdir=LR;
  graph [fontname="Helvetica", label="ws-trade-bot — one alert source, many independent trading apps", labelloc=t, fontsize=16];
  node [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge [color="#57606a", fontname="Helvetica", fontsize=9];

  phone [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white">
      <TR><TD BGCOLOR="#8957e5" COLSPAN="2"><FONT COLOR="white"><B>your phone / browser</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT">dashboards</TD><TD ALIGN="LEFT">5s poll · per app</TD></TR>
      <TR><TD ALIGN="LEFT">Discord app</TD><TD ALIGN="LEFT">webhook notifications</TD></TR>
    </TABLE>>];

  github [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white">
      <TR><TD BGCOLOR="#1f6feb" COLSPAN="2"><FONT COLOR="white"><B>GitHub</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT">siicosmos/ws-trade-bot</TD><TD ALIGN="LEFT">private repo</TD></TR>
      <TR><TD ALIGN="LEFT" COLSPAN="2">CI: rolling consumer-latest Release on every push</TD></TR>
    </TABLE>>];

  ws [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white">
      <TR><TD BGCOLOR="#1f6feb" COLSPAN="2"><FONT COLOR="white"><B>Wealthsimple</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT">GraphQL gateway</TD><TD ALIGN="LEFT">allowlisted documents</TD></TR>
      <TR><TD ALIGN="LEFT">activities · quotes</TD><TD ALIGN="LEFT">orders (consumer live mode)</TD></TR>
    </TABLE>>];

  moomoo [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white">
      <TR><TD BGCOLOR="#238636" COLSPAN="2"><FONT COLOR="white"><B>moomoo OpenD</B> (optional)</FONT></TD></TR>
      <TR><TD ALIGN="LEFT">realtime quotes</TD><TD ALIGN="LEFT">read-only · no orders</TD></TR>
    </TABLE>>];

  subgraph cluster_pc {
    label="owner's PC (Windows) — start_reader.bat / start_info.bat / start_consumer.bat restart loops";
    fontsize=13;
    color="#30363d";

    reader [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white">
        <TR><TD BGCOLOR="#8957e5" COLSPAN="2"><FONT COLOR="white"><B>reader</B> — standalone</FONT></TD></TR>
        <TR><TD ALIGN="LEFT">discord_reader.py</TD><TD ALIGN="LEFT">UIA on the Discord client</TD></TR>
        <TR><TD ALIGN="LEFT">parser + seen-set</TD><TD ALIGN="LEFT">relevance-gated restarts</TD></TR>
      </TABLE>>];

    subgraph cluster_info {
      label="info/ — the alert source (ingest + feed, no trading)";
      fontsize=12;
      color="#1f6feb";

      iweb [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white">
          <TR><TD BGCOLOR="#1f6feb" COLSPAN="2"><FONT COLOR="white"><B>ingest + feed</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT">POST /alert → parse</TD><TD ALIGN="LEFT">dedupe · record signal</TD></TR>
          <TR><TD ALIGN="LEFT">GET /api/feed</TD><TD ALIGN="LEFT">long-poll · cursor · levels</TD></TR>
          <TR><TD ALIGN="LEFT">fan-out thread</TD><TD ALIGN="LEFT">push → consumers' /alert</TD></TR>
        </TABLE>>];

      istore [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white">
          <TR><TD BGCOLOR="#1f6feb" COLSPAN="2"><FONT COLOR="white"><B>store</B> — SQLite (WAL)</FONT></TD></TR>
          <TR><TD ALIGN="LEFT">signals (the feed)</TD><TD ALIGN="LEFT">meta (levels text)</TD></TR>
        </TABLE>>];

      infodash [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white">
          <TR><TD BGCOLOR="#1f6feb" COLSPAN="2"><FONT COLOR="white"><B>info dashboard</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT">consumer health</TD><TD ALIGN="LEFT">reader line · levels editor</TD></TR>
        </TABLE>>];
    }

    subgraph cluster_consumer {
      label="consumer/ — the trading app (own ws login, own store, own dashboard)";
      fontsize=12;
      color="#8957e5";

      cfeed [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white">
          <TR><TD BGCOLOR="#8957e5" COLSPAN="2"><FONT COLOR="white"><B>alert sources</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT">/alert route (push)</TD><TD ALIGN="LEFT">feed client (long-poll)</TD></TR>
          <TR><TD ALIGN="LEFT" COLSPAN="2">atomic signal claim - dual delivery is idempotent</TD></TR>
        </TABLE>>];

      cproc [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white">
          <TR><TD BGCOLOR="#8957e5" COLSPAN="2"><FONT COLOR="white"><B>trading pipeline</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT">risk engine</TD><TD ALIGN="LEFT">sizing · caps</TD></TR>
          <TR><TD ALIGN="LEFT">mode slider</TD><TD ALIGN="LEFT">notify · paper · live</TD></TR>
        </TABLE>>];

      cexec [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white">
          <TR><TD BGCOLOR="#8957e5" COLSPAN="2"><FONT COLOR="white"><B>own executors + ledgers</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT">paper ledger (seeded)</TD><TD ALIGN="LEFT">live executor (own ws login)</TD></TR>
          <TR><TD ALIGN="LEFT">stop monitor</TD><TD ALIGN="LEFT">mirror · fill reconciliation</TD></TR>
        </TABLE>>];

      cstore [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white">
          <TR><TD BGCOLOR="#8957e5" COLSPAN="2"><FONT COLOR="white"><B>own store</B> — SQLite (WAL)</FONT></TD></TR>
          <TR><TD ALIGN="LEFT">signals · trades · positions</TD><TD ALIGN="LEFT">pending_orders · meta</TD></TR>
        </TABLE>>];

      cdash [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white">
          <TR><TD BGCOLOR="#8957e5" COLSPAN="2"><FONT COLOR="white"><B>own dashboard</B> — localhost</FONT></TD></TR>
          <TR><TD ALIGN="LEFT">cards · positions · trade log</TD><TD ALIGN="LEFT">settings · mode slider · accounts editor</TD></TR>
        </TABLE>>];

      cupd [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white">
          <TR><TD BGCOLOR="#238636" COLSPAN="2"><FONT COLOR="white"><B>auto-updater — release channel</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT">polls consumer-latest</TD><TD ALIGN="LEFT">verify + stage → launcher applies</TD></TR>
        </TABLE>>];
    }
  }

  reader -> iweb [label="POST /alert\ntoken", dir=forward];
  reader -> iweb [label="heartbeat\nreader status", style=dashed];
  iweb -> iweb [label="fan-out: push each\nsignal to consumers", style=dashed];
  iweb -> store_note [style=invis];
  store_note [style=invis];
  iweb -> istore [dir=forward];
  cfeed -> cproc [label="alert", dir=forward];
  cproc -> cexec [dir=forward];
  cexec -> cstore [dir=forward];
  cproc -> cstore [dir=forward];
  cdash -> cproc [label="5s poll", style=dashed];
  infodash -> iweb [label="poll", style=dashed];

  phone -> cdash [label="Tailscale\n(optional)", dir=forward];
  phone -> infodash [label="Tailscale", dir=forward];
  phone -> iweb [label="consumer push\n(when reachable)", style=dashed, color="#8957e5"];
  cfeed -> iweb [label="long-pull\nGET /api/feed", style=dashed, color="#238636"];

  cexec -> ws [label="positions · values\norders (live)", style=dashed];
  cexec -> moomoo [label="option/index quotes\n(stop monitor · ladder)", style=dashed, color="#238636"];
  phone -> ws [style=invis];

  // updates: info pulls git (the reader rides that pull), the
  // consumer follows the rolling release
  github -> iweb [label="git pull\n(info server)", style=dashed, color="#1f6feb"];
  github -> cupd [label="consumer-<sha>.zip\n+ SHA256SUMS", style=dashed, color="#238636"];
  cupd -> cproc [label="staged swap\non restart", style=dashed, color="#d29922"];
}
