// ws-trade-bot trades.db schema - render with:
//   dot -Tpng -o docs/db_schema.png docs/db_schema.dot
digraph db_schema {
  rankdir=LR;
  graph [fontname="Helvetica", label="trades.db — generated from core/store.py", labelloc=t, fontsize=16];
  node [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge [color="#57606a", fontname="Helvetica", fontsize=9];

  signals [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
      <TR><TD BGCOLOR="#1f6feb" COLSPAN="2"><FONT COLOR="white"><B>signals</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>message_key</B></TD><TD ALIGN="LEFT">TEXT · PK</TD></TR>
      <TR><TD ALIGN="LEFT">ts</TD><TD ALIGN="LEFT">TEXT NOT NULL · UTC</TD></TR>
      <TR><TD ALIGN="LEFT">author</TD><TD ALIGN="LEFT">TEXT</TD></TR>
      <TR><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT">TEXT</TD></TR>
      <TR><TD ALIGN="LEFT">parsed</TD><TD ALIGN="LEFT">INTEGER · 1=alert</TD></TR>
      <TR><TD ALIGN="LEFT">correction</TD><TD ALIGN="LEFT">INTEGER · 1=correction</TD></TR>
      <TR><TD ALIGN="LEFT">channel</TD><TD ALIGN="LEFT">TEXT</TD></TR>
      <TR><TD ALIGN="LEFT">received_ts</TD><TD ALIGN="LEFT">TEXT · UTC</TD></TR>
    </TABLE>>];

  trades [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
      <TR><TD BGCOLOR="#1f6feb" COLSPAN="2"><FONT COLOR="white"><B>trades</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">INTEGER · PK auto</TD></TR>
      <TR><TD ALIGN="LEFT">ts</TD><TD ALIGN="LEFT">TEXT NOT NULL · UTC</TD></TR>
      <TR><TD ALIGN="LEFT">mode</TD><TD ALIGN="LEFT">TEXT NOT NULL</TD></TR>
      <TR><TD ALIGN="LEFT">action</TD><TD ALIGN="LEFT">TEXT NOT NULL · BUY/SELL</TD></TR>
      <TR><TD ALIGN="LEFT">ticker</TD><TD ALIGN="LEFT">TEXT NOT NULL</TD></TR>
      <TR><TD ALIGN="LEFT">qty</TD><TD ALIGN="LEFT">INTEGER NOT NULL</TD></TR>
      <TR><TD ALIGN="LEFT">price / entry / stop_loss / take_profit</TD><TD ALIGN="LEFT">REAL</TD></TR>
      <TR><TD ALIGN="LEFT">strike / expiry / opt_right</TD><TD ALIGN="LEFT">REAL / TEXT / TEXT · contract</TD></TR>
      <TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">TEXT NOT NULL</TD></TR>
      <TR><TD ALIGN="LEFT">detail</TD><TD ALIGN="LEFT">TEXT · sizing</TD></TR>
      <TR><TD ALIGN="LEFT">message_key</TD><TD ALIGN="LEFT">TEXT → signals</TD></TR>
      <TR><TD ALIGN="LEFT">dedupe_key</TD><TD ALIGN="LEFT">TEXT → signals</TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9"><I>idx: (mode, ts) · (dedupe_key, ts)</I></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9"><I>daily prune &gt; retention</I></FONT></TD></TR>
    </TABLE>>];

  positions [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
      <TR><TD BGCOLOR="#1f6feb" COLSPAN="2"><FONT COLOR="white"><B>positions</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>mode + account + contract_key</B></TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">underlying</TD><TD ALIGN="LEFT">TEXT NOT NULL</TD></TR>
      <TR><TD ALIGN="LEFT">expiry / right</TD><TD ALIGN="LEFT">TEXT</TD></TR>
      <TR><TD ALIGN="LEFT">strike</TD><TD ALIGN="LEFT">REAL</TD></TR>
      <TR><TD ALIGN="LEFT">qty</TD><TD ALIGN="LEFT">INTEGER · &gt;0 when open</TD></TR>
      <TR><TD ALIGN="LEFT">updated_ts</TD><TD ALIGN="LEFT">TEXT · UTC</TD></TR>
      <TR><TD ALIGN="LEFT">avg_premium</TD><TD ALIGN="LEFT">REAL</TD></TR>
      <TR><TD ALIGN="LEFT">realized / peak_bid</TD><TD ALIGN="LEFT">REAL</TD></TR>
      <TR><TD ALIGN="LEFT">size</TD><TD ALIGN="LEFT">TEXT · size keyword</TD></TR>
      <TR><TD ALIGN="LEFT">tp_gain_pct / trail_pct</TD><TD ALIGN="LEFT">REAL · per-position guards</TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9"><I>PK covers (mode, account) lookups</I></FONT></TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>>];

  pending_orders [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
      <TR><TD BGCOLOR="#d29922" COLSPAN="2"><FONT COLOR="white"><B>pending_orders</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">INTEGER · PK auto</TD></TR>
      <TR><TD ALIGN="LEFT">placed_ts</TD><TD ALIGN="LEFT">TEXT NOT NULL · UTC</TD></TR>
      <TR><TD ALIGN="LEFT">mode / account</TD><TD ALIGN="LEFT">TEXT NOT NULL</TD></TR>
      <TR><TD ALIGN="LEFT">order_id</TD><TD ALIGN="LEFT">TEXT · broker id</TD></TR>
      <TR><TD ALIGN="LEFT">kind</TD><TD ALIGN="LEFT">TEXT · option (default) / stock</TD></TR>
      <TR><TD ALIGN="LEFT">contract_key</TD><TD ALIGN="LEFT">TEXT NOT NULL</TD></TR>
      <TR><TD ALIGN="LEFT">underlying / expiry / strike / opt_right</TD><TD ALIGN="LEFT">contract parts</TD></TR>
      <TR><TD ALIGN="LEFT">action</TD><TD ALIGN="LEFT">TEXT NOT NULL · BUY/SELL</TD></TR>
      <TR><TD ALIGN="LEFT">qty / est_price</TD><TD ALIGN="LEFT">INTEGER / REAL · estimate</TD></TR>
      <TR><TD ALIGN="LEFT">pre_qty / pre_avg</TD><TD ALIGN="LEFT">INTEGER / REAL · pre-order snapshot</TD></TR>
      <TR><TD ALIGN="LEFT">filled_qty / filled_price</TD><TD ALIGN="LEFT">INTEGER / REAL · accumulate</TD></TR>
      <TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">TEXT · open / filled / partial / expired / partial_cancelled</TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9"><I>idx: (mode, account, status, placed_ts)</I></FONT><BR/><FONT POINT-SIZE="9"><I>swept after 300s ttl · reconciled from the ws activity feed</I></FONT></TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>>];

  meta [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
      <TR><TD BGCOLOR="#1f6feb" COLSPAN="2"><FONT COLOR="white"><B>meta</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>key</B></TD><TD ALIGN="LEFT">TEXT · PK</TD></TR>
      <TR><TD ALIGN="LEFT">value</TD><TD ALIGN="LEFT">TEXT</TD></TR>
    </TABLE>>];

  users [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
      <TR><TD BGCOLOR="#8957e5" COLSPAN="2"><FONT COLOR="white"><B>users</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>username</B></TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT">pbkdf2 · 200k iters</TD></TR>
      <TR><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT">TEXT · admin</TD></TR>
      <TR><TD ALIGN="LEFT">created_ts / last_login_ts</TD><TD ALIGN="LEFT">TEXT · UTC</TD></TR>
    </TABLE>>];

  signals -> trades [arrowhead=crow, arrowtail=none, dir=both,
    label="1 signal · 0..* trades\nmessage_key / dedupe_key"];
}
